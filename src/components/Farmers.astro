---
interface Props {
  lang: 'en' | 'mr';
  dict: any;
}

const { lang, dict } = Astro.props;
---

<section class="section-opaque farmers-section" id="farmers" aria-label="Farmers procurement and registration">
  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <span class="section-tag">{dict.farmers.tag}</span>
      <h2 class="section-title">{dict.farmers.title}</h2>
      <p class="section-subtitle">
        {lang === 'mr'
          ? 'स्थानिक बागायतदार आणि व्यापाऱ्यांसाठी पारदर्शक व्यवहार, प्रत्यक्ष तपासणी आणि थेट बँक पेमेंट.'
          : 'Connecting growers with direct export buyers: verified weighing, transparent inspection, and prompt bank settlement.'}
      </p>
    </div>

    <!-- 1. How Selling Works (4 Steps) -->
    <div class="how-works-block">
      <h3 class="subsection-title">{dict.farmers.how_title}</h3>
      <div class="steps-grid" id="steps-container">
        {dict.farmers.steps.map((step: any, index: number) => (
          <div class="step-card" data-step={index + 1}>
            <div class="step-header">
              <span class="step-num">{step.num}</span>
              <div class="step-line" aria-hidden="true"></div>
            </div>
            <h4 class="step-title">{step.title}</h4>
            <p class="step-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- 2. Signature Widget: Farm Lot Registration Slip (Pavti) -->
    <div class="weighing-slip-section" id="weighing-slip">
      <div class="slip-intro">
        <span class="section-tag">{dict.farmers.slip.badge}</span>
        <h3 class="slip-main-title">{dict.farmers.slip.title}</h3>
      </div>

      <div class="slip-layout">
        <!-- Interactive Inputs Form -->
        <div class="slip-controls-panel">
          <!-- Role Toggle -->
          <div class="role-selector" role="radiogroup" aria-label="Role">
            <button type="button" class="role-btn active" id="btn-role-farmer" data-role="Farmer">
              👨‍🌾 {dict.farmers.slip.role_farmer}
            </button>
            <button type="button" class="role-btn" id="btn-role-dealer" data-role="Dealer">
              🤝 {dict.farmers.slip.role_dealer}
            </button>
          </div>

          <!-- Crop Selection -->
          <div class="form-group">
            <label for="slip-crop-select" class="form-label">{dict.farmers.slip.crop_label}</label>
            <select id="slip-crop-select" class="form-control">
              <option value="Grapes">{lang === 'mr' ? 'ताजी द्राक्षे (Grapes)' : 'Fresh Green Grapes'}</option>
              <option value="Pomegranate">{lang === 'mr' ? 'भगवा डाळिंब (Pomegranate)' : 'Bhagwa Pomegranate'}</option>
              <option value="Raisins">{lang === 'mr' ? 'सांगली बेदाणा (Raisins)' : 'Sangli Golden Raisins'}</option>
              <option value="Almonds">{lang === 'mr' ? 'कॅलिफोर्निया बदाम (Almonds)' : 'California Almonds'}</option>
              <option value="Dates">{lang === 'mr' ? 'शाही मेदजूल खजूर (Dates)' : 'Royal Medjool Dates'}</option>
              <option value="Cashews">{lang === 'mr' ? 'काजू गर (Cashews)' : 'Raw Cashew Kernels'}</option>
            </select>
          </div>

          <!-- Quantity Slider & Numeric Input -->
          <div class="form-group">
            <div class="qty-label-row">
              <label for="slip-qty-input" class="form-label">{dict.farmers.slip.qty_label}</label>
              <span class="qty-hint">{dict.farmers.slip.qty_hint}</span>
            </div>
            <div class="qty-inputs-row">
              <input
                type="range"
                id="slip-qty-slider"
                min="5"
                max="500"
                step="5"
                value="50"
                class="qty-slider"
                aria-label="Quantity in quintals slider"
              />
              <div class="qty-number-wrap">
                <input
                  type="number"
                  id="slip-qty-input"
                  min="1"
                  max="5000"
                  value="50"
                  inputmode="numeric"
                  class="form-control qty-number-input tabular-nums"
                  aria-label="Quantity in quintals numeric input"
                />
                <span class="qty-unit-addon">Qtl</span>
              </div>
            </div>
          </div>

          <!-- Location Details -->
          <div class="form-row-grid">
            <div class="form-group">
              <label for="slip-village" class="form-label">{dict.farmers.slip.village_label}</label>
              <input type="text" id="slip-village" class="form-control" placeholder={lang === 'mr' ? 'उदा. मनेराजुरी / कवठे' : 'e.g. Manerajuri'} value="Manerajuri" />
            </div>
            <div class="form-group">
              <label for="slip-taluka" class="form-label">{dict.farmers.slip.taluka_label}</label>
              <input type="text" id="slip-taluka" class="form-control" placeholder={lang === 'mr' ? 'उदा. तासगाव' : 'e.g. Tasgaon'} value="Tasgaon" />
            </div>
            <div class="form-group">
              <label for="slip-district" class="form-label">{dict.farmers.slip.district_label}</label>
              <select id="slip-district" class="form-control">
                <option value="Sangli">Sangli (सांगली)</option>
                <option value="Solapur">Solapur (सोलापूर)</option>
                <option value="Nashik">Nashik (नाशिक)</option>
                <option value="Pune">Pune (पुणे)</option>
                <option value="Satara">Satara (सातारा)</option>
              </select>
            </div>
          </div>

          <!-- Phone Number -->
          <div class="form-group">
            <label for="slip-phone" class="form-label">{dict.farmers.slip.phone_label}</label>
            <input
              type="tel"
              id="slip-phone"
              class="form-control tabular-nums"
              placeholder="+91 98765 43210"
              inputmode="numeric"
              required
            />
          </div>

          <!-- Dealer Specific Fields (Hidden by default for farmers) -->
          <div class="dealer-fields" id="dealer-extra-fields" style="display: none;">
            <div class="form-row-grid">
              <div class="form-group">
                <label for="slip-packing" class="form-label">{dict.farmers.slip.lot_size_label}</label>
                <input type="text" id="slip-packing" class="form-control" placeholder="10kg plastic crates / CFB" />
              </div>
              <div class="form-group">
                <label for="slip-avail" class="form-label">{dict.farmers.slip.availability_label}</label>
                <input type="date" id="slip-avail" class="form-control" />
              </div>
            </div>
          </div>
        </div>

        <!-- Realtime Paper Lot Registration Slip Widget -->
        <div class="slip-paper-container">
          <div class="paper-slip" id="live-paper-slip">
            <!-- Rubber Stamp Overlay -->
            <div class="rubber-stamp" id="rubber-stamp-el">
              {dict.farmers.slip.stamp_text}
            </div>

            <!-- Slip Header -->
            <div class="slip-bill-head">
              <div class="slip-brand">
                <span class="slip-brand-logo">DJ EXPORTS</span>
                <span class="slip-brand-loc">PACKHOUSE GAT NO. 479 • MANERAJURI</span>
              </div>
              <div class="slip-memo-id">
                <span class="memo-label">{dict.farmers.slip.receipt_id}</span>
                <strong class="memo-val tabular-nums" id="slip-memo-no">DJE-26-849</strong>
              </div>
            </div>

            <div class="slip-rule-double"></div>

            <!-- Slip Meta Grid -->
            <div class="slip-meta-grid">
              <div class="meta-item">
                <span class="meta-lbl">{dict.farmers.slip.receipt_date}</span>
                <span class="meta-val tabular-nums" id="slip-display-date">12 Oct 2026</span>
              </div>
              <div class="meta-item">
                <span class="meta-lbl">{dict.farmers.slip.receipt_seller}</span>
                <span class="meta-val" id="slip-display-role">Farmer (बागायतदार)</span>
              </div>
              <div class="meta-item">
                <span class="meta-lbl">{dict.farmers.slip.receipt_location}</span>
                <span class="meta-val" id="slip-display-location">Manerajuri, Tasgaon, Sangli</span>
              </div>
            </div>

            <div class="slip-rule"></div>

            <!-- Slip Content Rows -->
            <div class="slip-lines-table">
              <div class="slip-row">
                <span class="row-label">{lang === 'mr' ? 'शेतमाल प्रकार:' : 'Commodity / Crop:'}</span>
                <strong class="row-val" id="slip-display-crop">Fresh Green Grapes (द्राक्षे)</strong>
              </div>
              <div class="slip-row">
                <span class="row-label">{dict.farmers.slip.receipt_qty}</span>
                <strong class="row-val tabular-nums" id="slip-display-qty">50.00 Quintals (5,000 kg)</strong>
              </div>
              <div class="slip-row">
                <span class="row-label">{dict.farmers.slip.receipt_status}</span>
                <strong class="row-val text-leaf-highlight" id="slip-display-status">{dict.farmers.slip.receipt_status_val}</strong>
              </div>
              <div class="slip-row">
                <span class="row-label">{dict.farmers.slip.receipt_payment}</span>
                <strong class="row-val" id="slip-display-payment">{dict.farmers.slip.receipt_payment_val}</strong>
              </div>
            </div>

            <div class="slip-rule-double"></div>

            <!-- Grand Lot Status Banner -->
            <div class="slip-total-box">
              <div class="total-label">{lang === 'mr' ? 'नोंदणी स्थिती' : 'REGISTRATION STATUS'}</div>
              <div class="total-val text-leaf" id="slip-display-total">{lang === 'mr' ? 'थेट खरेदी कोटेशन तयार' : 'READY FOR DIRECT QUOTE'}</div>
            </div>

            <!-- Disclaimer -->
            <p class="slip-disclaimer">
              {dict.farmers.slip.receipt_disclaimer}
            </p>

            <!-- Actions inside Slip -->
            <div class="slip-action-wrap">
              <button type="button" class="btn btn-whatsapp slip-submit-btn" id="slip-whatsapp-trigger">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 6.46 17.5 2 12.04 2M12.05 3.67C16.58 3.67 20.28 7.37 20.28 11.92C20.28 16.46 16.58 20.17 12.04 20.17C10.59 20.17 9.17 19.79 7.92 19.05L7.62 18.87L4.5 19.69L5.33 16.65L5.13 16.33C4.33 15.05 3.8 13.51 3.8 11.91C3.81 7.37 7.51 3.67 12.05 3.67Z"/>
                </svg>
                <span>{dict.farmers.slip.send_whatsapp_btn}</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. What We Promise (4 Concrete Promises) -->
    <div class="promises-block">
      <h3 class="subsection-title">{dict.farmers.promises.title}</h3>
      <div class="promises-grid">
        {dict.farmers.promises.items.map((promise: any) => (
          <div class="promise-card">
            <div class="promise-icon">✓</div>
            <h4 class="promise-title">{promise.heading}</h4>
            <p class="promise-text">{promise.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .farmers-section {
    background-color: #F4F8F2;
    padding: 5.5rem 0;
  }

  .section-header {
    margin-bottom: 3.5rem;
  }

  .subsection-title {
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
    margin-bottom: 2rem;
    color: var(--canopy);
  }

  /* 1. Steps Grid */
  .how-works-block {
    margin-bottom: 5rem;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    position: relative;
  }

  .step-card {
    background: #FFFFFF;
    border: 1px solid var(--border-rule);
    border-radius: var(--radius);
    padding: 1.75rem 1.5rem;
    box-shadow: 2px 2px 0px rgba(15, 59, 44, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .step-card:hover {
    box-shadow: var(--shadow-hard-subtle);
    transform: translateY(-2px);
  }

  .step-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .step-num {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--leaf);
    background: rgba(46, 125, 79, 0.1);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius);
  }

  .step-line {
    flex: 1;
    height: 2px;
    background: #E0EADE;
  }

  .step-title {
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
    color: var(--canopy);
  }

  .step-desc {
    font-size: 0.9375rem;
    color: var(--ink-dim);
    line-height: 1.6;
  }

  /* 2. Weighing Slip Layout */
  .weighing-slip-section {
    margin-bottom: 5rem;
  }

  .slip-intro {
    margin-bottom: 2rem;
  }

  .slip-main-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--canopy);
  }

  .slip-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 992px) {
    .slip-layout {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .slip-controls-panel {
    background: #FFFFFF;
    border: 1px solid var(--border-rule);
    border-radius: var(--radius);
    padding: 2rem;
    box-shadow: 2px 2px 0px rgba(15, 59, 44, 0.08);
  }

  .role-selector {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .role-btn {
    min-height: 48px;
    padding: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 700;
    background: var(--mist);
    border: 1px solid var(--border-rule);
    border-radius: var(--radius);
    color: var(--canopy);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .role-btn.active {
    background: var(--canopy);
    color: #FFFFFF;
    border-color: var(--canopy);
    box-shadow: 2px 2px 0px rgba(0, 0, 0, 0.2);
  }

  .qty-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .qty-hint {
    font-size: 0.8125rem;
    color: var(--leaf);
    font-weight: 600;
  }

  .qty-inputs-row {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .qty-slider {
    flex: 1;
    height: 6px;
    accent-color: var(--leaf);
    cursor: pointer;
  }

  .qty-number-wrap {
    position: relative;
    width: 120px;
  }

  .qty-number-input {
    padding-right: 2.5rem;
    font-weight: 700;
    font-size: 1.125rem;
  }

  .qty-unit-addon {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.875rem;
    color: var(--ink-dim);
    font-weight: 600;
    pointer-events: none;
  }

  .form-row-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.875rem;
  }

  /* Paper Slip Styling */
  .slip-paper-container {
    position: sticky;
    top: 100px;
  }

  .paper-slip {
    padding: 2.25rem 2rem;
  }

  .slip-bill-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.25rem;
  }

  .slip-brand-logo {
    display: block;
    font-family: var(--font-display-en);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--canopy);
    letter-spacing: 0.05em;
  }

  .slip-brand-loc {
    display: block;
    font-size: 0.6875rem;
    color: var(--ink-dim);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .memo-label {
    display: block;
    font-size: 0.6875rem;
    color: var(--ink-dim);
    font-weight: 700;
  }

  .memo-val {
    font-size: 0.9375rem;
    color: var(--canopy);
    letter-spacing: 0.05em;
  }

  .slip-rule {
    height: 1px;
    background: #BAC9B7;
    margin: 1rem 0;
  }

  .slip-rule-double {
    height: 3px;
    border-top: 1px solid #BAC9B7;
    border-bottom: 1px solid #BAC9B7;
    margin: 1rem 0;
  }

  .slip-meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.75rem;
  }

  .meta-lbl {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--ink-dim);
  }

  .meta-val {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
  }

  .slip-lines-table {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .slip-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9375rem;
  }

  .row-label {
    color: var(--ink-dim);
    font-weight: 500;
  }

  .row-val {
    color: var(--ink);
  }

  .text-leaf-highlight {
    color: var(--leaf);
    font-weight: 700;
  }

  .slip-total-box {
    background: #FDF9F0;
    border: 1px solid #EAD8B5;
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .total-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--canopy);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .total-val {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--leaf);
  }

  .slip-disclaimer {
    font-size: 0.75rem;
    color: var(--ink-dim);
    line-height: 1.45;
    margin-bottom: 1.5rem;
    font-style: italic;
  }

  .slip-action-wrap {
    width: 100%;
  }

  .slip-submit-btn {
    width: 100%;
    font-size: 1.0625rem;
    padding: 1rem;
  }

  /* 3. Promises */
  .promises-block {
    margin-top: 2rem;
  }

  .promises-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .promise-card {
    background: #FFFFFF;
    border: 1px solid var(--border-rule);
    border-radius: var(--radius);
    padding: 1.75rem 1.5rem;
    box-shadow: 2px 2px 0px rgba(15, 59, 44, 0.08);
  }

  .promise-icon {
    width: 32px;
    height: 32px;
    background: rgba(46, 125, 79, 0.12);
    color: var(--leaf);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    margin-bottom: 1rem;
  }

  .promise-title {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
    color: var(--canopy);
  }

  .promise-text {
    font-size: 0.9375rem;
    color: var(--ink-dim);
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .paper-slip {
      padding: 1.5rem 1rem;
    }
    .total-val {
      font-size: 1rem;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Interactive Lot Registration Slip (Pavti)
    const roleFarmer = document.getElementById('btn-role-farmer');
    const roleDealer = document.getElementById('btn-role-dealer');
    const dealerFields = document.getElementById('dealer-extra-fields');

    const cropSelect = document.getElementById('slip-crop-select');
    const qtySlider = document.getElementById('slip-qty-slider');
    const qtyInput = document.getElementById('slip-qty-input');
    const villageInput = document.getElementById('slip-village');
    const talukaInput = document.getElementById('slip-taluka');
    const districtSelect = document.getElementById('slip-district');
    const phoneInput = document.getElementById('slip-phone');

    // Live display elements on paper slip
    const displayRole = document.getElementById('slip-display-role');
    const displayLocation = document.getElementById('slip-display-location');
    const displayCrop = document.getElementById('slip-display-crop');
    const displayQty = document.getElementById('slip-display-qty');
    const stampEl = document.getElementById('rubber-stamp-el');
    const whatsappTrigger = document.getElementById('slip-whatsapp-trigger');

    let currentRole = 'Farmer';

    function setRole(role) {
      currentRole = role;
      if (role === 'Farmer') {
        roleFarmer.classList.add('active');
        roleDealer.classList.remove('active');
        dealerFields.style.display = 'none';
        displayRole.textContent = 'Farmer (बागायतदार)';
      } else {
        roleDealer.classList.add('active');
        roleFarmer.classList.remove('active');
        dealerFields.style.display = 'block';
        displayRole.textContent = 'Dealer / Trader (व्यापारी)';
      }
    }

    if (roleFarmer && roleDealer) {
      roleFarmer.addEventListener('click', () => setRole('Farmer'));
      roleDealer.addEventListener('click', () => setRole('Dealer'));
    }

    function updateSlipCalculations() {
      const qtl = parseFloat(qtyInput.value) || 0;
      const selectedOption = cropSelect.options[cropSelect.selectedIndex];
      const cropText = selectedOption ? selectedOption.text : 'Grapes';
      const kg = Math.round(qtl * 100);

      const village = (villageInput.value || '').trim() || 'Manerajuri';
      const taluka = (talukaInput.value || '').trim() || 'Tasgaon';
      const district = districtSelect.value;

      displayCrop.textContent = cropText;
      displayQty.textContent = `${qtl.toLocaleString('en-IN')} Quintals (${kg.toLocaleString('en-IN')} kg)`;
      displayLocation.textContent = `${village}, ${taluka}, ${district}`;
    }

    if (qtySlider && qtyInput) {
      qtySlider.addEventListener('input', () => {
        qtyInput.value = qtySlider.value;
        updateSlipCalculations();
      });

      qtyInput.addEventListener('input', () => {
        qtySlider.value = qtyInput.value;
        updateSlipCalculations();
      });
    }

    if (cropSelect) cropSelect.addEventListener('change', updateSlipCalculations);
    if (villageInput) villageInput.addEventListener('input', updateSlipCalculations);
    if (talukaInput) talukaInput.addEventListener('input', updateSlipCalculations);
    if (districtSelect) districtSelect.addEventListener('change', updateSlipCalculations);

    // Initial calculation
    updateSlipCalculations();

    // WhatsApp Hand-off with Stamp Animation
    if (whatsappTrigger) {
      whatsappTrigger.addEventListener('click', () => {
        const phone = (phoneInput.value || '').trim();
        if (!phone) {
          phoneInput.focus();
          phoneInput.style.borderColor = '#C0392B';
          return;
        }

        // Trigger rubber stamp visual punch
        if (stampEl) {
          stampEl.classList.add('stamped');
        }

        const qtl = qtyInput.value;
        const crop = cropSelect.options[cropSelect.selectedIndex].text;
        const loc = displayLocation.textContent;
        const memo = document.getElementById('slip-memo-no').textContent;

        const message = `*DJ FRUITS PRODUCE REGISTRATION [${memo}]*\n` +
          `• Role: ${currentRole}\n` +
          `• Commodity: ${crop}\n` +
          `• Estimated Quantity: ${qtl} Quintals\n` +
          `• Farm Location: ${loc}\n` +
          `• Contact Phone: ${phone}\n` +
          `• Request: Please confirm farm inspection and provide your competitive buying quote.\n\n` +
          `Sent from DJ Fruits Online Portal`;

        const waUrl = `https://wa.me/919130659595?text=${encodeURIComponent(message)}`;

        setTimeout(() => {
          window.open(waUrl, '_blank');
        }, 350);
      });
    }
  });
</script>
