---
import siteData from '../../content/site.json';

interface Props {
  lang: 'en' | 'mr';
  dict: any;
}

const { lang, dict } = Astro.props;

const defaultWhatsAppText = lang === 'mr'
  ? 'नमस्कार, मला डीजे फ्रूट्सकडे शेतमाल विक्रीसाठी चौकशी करायची आहे.'
  : 'Hello DJ Fruits Export desk, I would like to enquire about selling fresh produce.';
const whatsappUrl = `https://wa.me/919130659595?text=${encodeURIComponent(defaultWhatsAppText)}`;
---

<!-- Hero Section with Clearly Visible Looping Background Video & High-Contrast Protected Typography -->
<section class="hero-section" id="hero" aria-label="Introduction and Overview">
  <!-- Looping Background Video Container -->
  <div class="hero-video-box" aria-hidden="true">
    <video
      id="heroBgVideo"
      class="hero-video-element"
      src="/bg2.mp4"
      autoplay
      loop
      muted
      playsinline
      webkit-playsinline
      preload="auto"
      disablepictureinpicture
      poster="/backgrounds/bg-poster.jpg"
    >
      <source src="/bg2.mp4" type="video/mp4" />
      <source src="/backgrounds/bg-scrub.mp4" type="video/mp4" />
    </video>
    <!-- Directional Cinematic Scrim: High-contrast on left (text side), clear & vibrant on right (vineyard video) -->
    <div class="hero-video-scrim"></div>
  </div>

  <!-- Foreground Content: Encased in High-Contrast Frosted Glass Card for 100% Guaranteed Legibility -->
  <div class="container hero-container">
    <div class="hero-card">
      
      <!-- Procurement Badge -->
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        <span>{lang === 'mr' ? 'थेट शेतमाल खरेदी सत्र २०२६-२७' : 'DIRECT PROCUREMENT SEASON 2026-27'}</span>
      </div>

      <!-- Main Headline: Large, Crisp White with Contrast Shadow -->
      <h1 class="hero-title">
        {dict.hero.h1}
      </h1>

      <!-- Supporting Subline -->
      <p class="hero-subline">
        {dict.hero.subline}
      </p>

      <!-- Primary Action Buttons -->
      <div class="hero-actions">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp hero-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 6.46 17.5 2 12.04 2M12.05 3.67C16.58 3.67 20.28 7.37 20.28 11.92C20.28 16.46 16.58 20.17 12.04 20.17C10.59 20.17 9.17 19.79 7.92 19.05L7.62 18.87L4.5 19.69L5.33 16.65L5.13 16.33C4.33 15.05 3.8 13.51 3.8 11.91C3.81 7.37 7.51 3.67 12.05 3.67Z"/>
          </svg>
          <span>{dict.hero.cta_sell}</span>
        </a>

        <a href="#gallery" class="btn btn-rates hero-btn">
          <span>{dict.hero.cta_gallery}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
        </a>
      </div>

      <!-- Trust Strip Cards -->
      <div class="hero-trust-strip">
        <div class="trust-item">
          <div class="trust-icon">🏢</div>
          <div class="trust-text">
            <strong>{dict.hero.trust.collection}</strong>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-icon">🗺️</div>
          <div class="trust-text">
            <strong>{dict.hero.trust.districts}</strong>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-icon">⚡</div>
          <div class="trust-text">
            <strong>{dict.hero.trust.payment}</strong>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-icon">⚖️</div>
          <div class="trust-text">
            <strong>{dict.hero.trust.scale}</strong>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: calc(100vh - 85px);
    min-height: calc(100svh - 85px);
    display: flex;
    align-items: center;
    background-color: #071E15;
    padding: 3.5rem 0 4.5rem;
    box-sizing: border-box;
    overflow: hidden;
  }

  /* Looping Background Video */
  .hero-video-box {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
    pointer-events: none;
    background-color: #071E15;
  }

  .hero-video-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    display: block;
    opacity: 0.95;
  }

  /* Directional Scrim: Dark on left behind card, transparent on right so the vineyard video is clearly visible */
  .hero-video-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(5, 20, 14, 0.90) 0%,
      rgba(6, 24, 17, 0.75) 45%,
      rgba(7, 26, 19, 0.35) 75%,
      rgba(7, 26, 19, 0.15) 100%
    );
    pointer-events: none;
  }

  /* Foreground Content */
  .hero-container {
    position: relative;
    z-index: 10;
    width: 100%;
  }

  /* High-Contrast Frosted Glass Hero Card */
  .hero-card {
    max-width: 840px;
    background: rgba(7, 26, 19, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.20);
    border-radius: 12px;
    padding: 2.25rem 2.5rem;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(143, 191, 106, 0.15);
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.35rem 0.9rem;
    background: rgba(143, 191, 106, 0.15);
    border: 1px solid var(--sprout);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--sprout);
    margin-bottom: 1.25rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--sprout);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--sprout);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* Main Title: Crisp White with Contrast Shadow */
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.2;
    color: #FFFFFF !important;
    margin-bottom: 1.15rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
    letter-spacing: -0.01em;
  }

  /* Subline */
  .hero-subline {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.6;
    color: #EDF5EC !important;
    max-width: 740px;
    margin-bottom: 1.85rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    font-weight: 450;
  }

  /* Action Buttons */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .hero-btn {
    font-size: 1rem;
    font-weight: 600;
    padding: 0.85rem 1.65rem;
    border-radius: var(--radius);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }

  .btn-rates {
    background: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .btn-rates:hover {
    background: #FFFFFF;
    color: #071E15;
    border-color: #FFFFFF;
  }

  /* Trust Strip */
  .hero-trust-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .trust-item {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .trust-icon {
    font-size: 1.25rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .trust-text strong {
    font-size: 0.8125rem;
    color: #F0F6EF !important;
    font-weight: 600;
    line-height: 1.35;
    display: block;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 900px) {
    .hero-trust-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .hero-card {
      background: rgba(7, 26, 19, 0.60);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    .hero-video-scrim {
      background: linear-gradient(
        180deg,
        rgba(5, 20, 14, 0.45) 0%,
        rgba(6, 24, 17, 0.30) 45%,
        rgba(7, 26, 19, 0.55) 100%
      );
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 1.75rem 0 2.5rem;
      min-height: auto;
    }
    .hero-card {
      padding: 1.35rem 1.15rem;
      border-radius: 12px;
      /* Soft glass transparency so background video is clearly visible */
      background: rgba(7, 26, 19, 0.42);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border: 1px solid rgba(255, 255, 255, 0.22);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }
    .hero-video-element {
      opacity: 1;
    }
    /* Transparent scrim ensuring background video is bright & clearly visible */
    .hero-video-scrim {
      background: linear-gradient(
        180deg,
        rgba(5, 20, 14, 0.35) 0%,
        rgba(6, 24, 17, 0.18) 45%,
        rgba(7, 26, 19, 0.48) 100%
      );
    }
    .hero-title {
      font-size: 1.65rem;
      line-height: 1.25;
      margin-bottom: 0.85rem;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.95);
    }
    .hero-subline {
      font-size: 0.9375rem;
      line-height: 1.5;
      margin-bottom: 1.35rem;
      text-shadow: 0 1px 6px rgba(0, 0, 0, 0.9);
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .hero-btn {
      width: 100%;
      padding: 0.8rem 1.25rem;
      font-size: 0.9375rem;
    }
    .hero-trust-strip {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding-top: 1.15rem;
    }
  }
</style>

<script is:inline>
  // Instant, robust video autoplay engine with cross-browser compatibility
  (function() {
    function setupHeroVideo() {
      var video = document.getElementById('heroBgVideo');
      if (!video) return;

      // Force HTML5 muted properties for mobile & modern browsers
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.setAttribute('muted', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');

      function tryPlay() {
        var promise = video.play();
        if (promise !== undefined) {
          promise.catch(function() {
            // If autoplay is initially blocked by browser policy, play on first user interaction
            function onUserInteract() {
              video.play();
              window.removeEventListener('touchstart', onUserInteract);
              window.removeEventListener('pointerdown', onUserInteract);
              window.removeEventListener('click', onUserInteract);
              window.removeEventListener('scroll', onUserInteract);
            }
            window.addEventListener('touchstart', onUserInteract, { once: true, passive: true });
            window.addEventListener('pointerdown', onUserInteract, { once: true, passive: true });
            window.addEventListener('click', onUserInteract, { once: true, passive: true });
            window.addEventListener('scroll', onUserInteract, { once: true, passive: true });
          });
        }
      }

      // If video has loaded enough data, play immediately; otherwise listen for canplay
      if (video.readyState >= 2) {
        tryPlay();
      } else {
        video.addEventListener('canplay', tryPlay, { once: true });
        video.addEventListener('loadeddata', tryPlay, { once: true });
        // Fallback safety timeout
        setTimeout(tryPlay, 150);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupHeroVideo);
    } else {
      setupHeroVideo();
    }
  })();
</script>
