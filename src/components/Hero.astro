---
import siteData from '../../content/site.json';

interface Props {
  lang: 'en' | 'mr';
  dict: any;
}

const { lang, dict } = Astro.props;

const defaultWhatsAppText = lang === 'mr'
  ? 'नमस्कार, मला डीजे फ्रूट्सकडे शेतमाल विक्रीसाठी चौकशी करायची आहे.'
  : 'Hello DJ Fruits Export desk, I would like to enquire about selling fresh produce.';
const whatsappUrl = `https://wa.me/919130659595?text=${encodeURIComponent(defaultWhatsAppText)}`;
---

<!-- Fixed Background Scrub Video Layer (aria-hidden) -->
<div id="bg-scrub" aria-hidden="true">
  <video
    id="bgVideo"
    muted
    playsinline
    webkit-playsinline
    preload="none"
    disablepictureinpicture
    tabindex="-1"
    poster="/backgrounds/bg-poster.jpg"
  >
    <source src="/backgrounds/bg-scrub.mp4" type="video/mp4" />
  </video>
  <div class="bg-shade"></div>
</div>

<!-- Hero Section -->
<section class="hero-section" id="hero" aria-label="Introduction and Overview">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        <span>{lang === 'mr' ? 'थेट शेतमाल खरेदी सत्र २०२६-२७' : 'DIRECT PROCUREMENT SEASON 2026-27'}</span>
      </div>

      <h1 class="hero-title">
        {dict.hero.h1}
      </h1>

      <p class="hero-subline">
        {dict.hero.subline}
      </p>

      <div class="hero-actions">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp hero-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 6.46 17.5 2 12.04 2M12.05 3.67C16.58 3.67 20.28 7.37 20.28 11.92C20.28 16.46 16.58 20.17 12.04 20.17C10.59 20.17 9.17 19.79 7.92 19.05L7.62 18.87L4.5 19.69L5.33 16.65L5.13 16.33C4.33 15.05 3.8 13.51 3.8 11.91C3.81 7.37 7.51 3.67 12.05 3.67Z"/>
          </svg>
          <span>{dict.hero.cta_sell}</span>
        </a>

        <a href="#mandi-rates" class="btn btn-secondary hero-btn">
          <span>{dict.hero.cta_rates}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </a>
      </div>

      <!-- Trust Strip: Confirmed Facts Only -->
      <div class="hero-trust-strip">
        <div class="trust-item">
          <div class="trust-icon">🏢</div>
          <div class="trust-text">
            <strong>{dict.hero.trust.collection}</strong>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-icon">🗺️</div>
          <div class="trust-text">
            <strong>{dict.hero.trust.districts}</strong>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-icon">⚡</div>
          <div class="trust-text">
            <strong>{dict.hero.trust.payment}</strong>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-icon">⚖️</div>
          <div class="trust-text">
            <strong>{dict.hero.trust.scale}</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: calc(100svh - 85px);
    display: flex;
    align-items: center;
    position: relative;
    padding: 3.5rem 0 4rem;
    z-index: 2;
  }

  .hero-container {
    width: 100%;
  }

  .hero-content {
    max-width: 860px;
    color: #FFFFFF;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.35rem 0.85rem;
    background: rgba(143, 191, 106, 0.15);
    border: 1px solid rgba(143, 191, 106, 0.35);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--sprout);
    margin-bottom: 1.5rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--sprout);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--sprout);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.2vw, 4.25rem);
    font-weight: 700;
    line-height: 1.12;
    color: #FFFFFF;
    margin-bottom: 1.25rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .hero-subline {
    font-size: clamp(1.125rem, 2vw, 1.35rem);
    line-height: 1.55;
    color: #E2ECE0;
    max-width: 720px;
    margin-bottom: 2.25rem;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .hero-btn {
    font-size: 1.0625rem;
    padding: 0.95rem 1.85rem;
  }

  /* Trust Strip */
  .hero-trust-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    background: rgba(10, 36, 27, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
  }

  .trust-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .trust-icon {
    font-size: 1.25rem;
    line-height: 1;
  }

  .trust-text strong {
    font-size: 0.875rem;
    color: #E8F1E6;
    font-weight: 600;
    line-height: 1.4;
    display: block;
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .hero-btn {
      width: 100%;
    }
    .hero-trust-strip {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  // Video Scroll Scrubbing Engine with Weak-Network Protection
  document.addEventListener('DOMContentLoaded', () => {
    const video = document.getElementById('bgVideo');
    if (!video) return;

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Check Network conditions (Save-Data or 2G/3G)
    const conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    const isSaveData = conn && conn.saveData;
    const isSlowNetwork = conn && (conn.effectiveType === '2g' || conn.effectiveType === 'slow-2g');

    if (prefersReducedMotion || isSaveData || isSlowNetwork) {
      // Fallback cleanly to poster only, no video request
      return;
    }

    // Lazy load video source once page is idle
    const loadVideo = () => {
      video.preload = 'auto';
      video.load();

      const initScrub = () => {
        if (!isFinite(video.duration) || video.duration <= 0) return;
        video.pause();

        if (window.gsap && window.ScrollTrigger) {
          gsap.registerPlugin(ScrollTrigger);

          // Eased scrubber variant for buttery frame seeking
          let targetTime = 0;
          let currentTime = 0;

          ScrollTrigger.create({
            trigger: 'body',
            start: 'top top',
            end: 'bottom bottom',
            scrub: true,
            onUpdate: (self) => {
              targetTime = self.progress * video.duration;
            }
          });

          gsap.ticker.add(() => {
            const delta = targetTime - currentTime;
            if (Math.abs(delta) > 0.02) {
              currentTime += delta * 0.15;
              video.currentTime = currentTime;
            }
          });

          ScrollTrigger.refresh();
        }
      };

      if (video.readyState >= 1) {
        initScrub();
      } else {
        video.addEventListener('loadedmetadata', initScrub, { once: true });
      }

      // iOS touch gesture unlock
      const unlock = () => {
        video.play().then(() => video.pause()).catch(() => {});
      };
      window.addEventListener('touchstart', unlock, { once: true, passive: true });
    };

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(loadVideo, { timeout: 2500 });
    } else {
      setTimeout(loadVideo, 800);
    }
  });
</script>
