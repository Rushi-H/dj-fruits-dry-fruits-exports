---
import siteData from '../../content/site.json';

interface Props {
  lang: 'en' | 'mr';
  dict: any;
}

const { lang, dict } = Astro.props;

const defaultWhatsAppText = lang === 'mr'
  ? 'नमस्कार, मला डीजे फ्रूट्सकडे शेतमाल विक्रीसाठी चौकशी करायची आहे.'
  : 'Hello DJ Fruits Export desk, I would like to enquire about selling fresh produce.';
const whatsappUrl = `https://wa.me/919130659595?text=${encodeURIComponent(defaultWhatsAppText)}`;
---

<!-- Extended Hero Scroll Container: Stays pinned while scrolling through video animation -->
<section class="hero-scroll-track" id="hero-track" aria-label="Introduction and Harvest Showcase">
  <div class="hero-sticky-stage" id="hero-stage">
    
    <!-- Background Video directly integrated inside Hero -->
    <div class="hero-video-box" aria-hidden="true">
      <video
        id="heroBgVideo"
        class="hero-video-element"
        muted
        playsinline
        webkit-playsinline
        preload="auto"
        disablepictureinpicture
        tabindex="-1"
        poster="/backgrounds/bg-poster.jpg"
      >
        <source src="/bg2.mp4" type="video/mp4" />
        <source src="/backgrounds/bg-scrub.mp4" type="video/mp4" />
      </video>
      <!-- Cinematic contrast overlay with vignette -->
      <div class="hero-video-scrim"></div>
    </div>

    <!-- Foreground Content -->
    <div class="hero-overlay-layer">
      <div class="container hero-container">
        <div class="hero-content" id="hero-content-panel">
          <div class="hero-badge">
            <span class="pulse-dot"></span>
            <span>{lang === 'mr' ? 'थेट शेतमाल खरेदी सत्र २०२६-२७' : 'DIRECT PROCUREMENT SEASON 2026-27'}</span>
          </div>

          <h1 class="hero-title">
            {dict.hero.h1}
          </h1>

          <p class="hero-subline">
            {dict.hero.subline}
          </p>

          <div class="hero-actions">
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp hero-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 6.46 17.5 2 12.04 2M12.05 3.67C16.58 3.67 20.28 7.37 20.28 11.92C20.28 16.46 16.58 20.17 12.04 20.17C10.59 20.17 9.17 19.79 7.92 19.05L7.62 18.87L4.5 19.69L5.33 16.65L5.13 16.33C4.33 15.05 3.8 13.51 3.8 11.91C3.81 7.37 7.51 3.67 12.05 3.67Z"/>
              </svg>
              <span>{dict.hero.cta_sell}</span>
            </a>

            <a href="#mandi-rates" class="btn btn-secondary hero-btn">
              <span>{dict.hero.cta_rates}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <polyline points="19 12 12 19 5 12"></polyline>
              </svg>
            </a>
          </div>

          <!-- Trust Strip: Confirmed Facts Only -->
          <div class="hero-trust-strip">
            <div class="trust-item">
              <div class="trust-icon">🏢</div>
              <div class="trust-text">
                <strong>{dict.hero.trust.collection}</strong>
              </div>
            </div>

            <div class="trust-item">
              <div class="trust-icon">🗺️</div>
              <div class="trust-text">
                <strong>{dict.hero.trust.districts}</strong>
              </div>
            </div>

            <div class="trust-item">
              <div class="trust-icon">⚡</div>
              <div class="trust-text">
                <strong>{dict.hero.trust.payment}</strong>
              </div>
            </div>

            <div class="trust-item">
              <div class="trust-icon">⚖️</div>
              <div class="trust-text">
                <strong>{dict.hero.trust.scale}</strong>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Video Scrub Progress & Guide Widget -->
    <div class="hero-scrub-indicator" id="hero-scrub-indicator" aria-hidden="true">
      <div class="scrub-bar-track">
        <div class="scrub-bar-fill" id="scrub-bar-fill"></div>
      </div>
      <div class="scrub-label-row">
        <span class="scrub-hint">
          {lang === 'mr' ? 'द्राक्ष बागेचा व्हिडिओ पाहण्यासाठी खाली स्क्रोल करा' : 'Scroll down to play vineyard video'}
        </span>
        <span class="scrub-pct tabular-nums" id="scrub-pct">0%</span>
      </div>
    </div>

  </div>
</section>

<style>
  /* Extended Scroll Track: gives sufficient scroll height for complete video playback */
  .hero-scroll-track {
    position: relative;
    height: 400vh; /* 4x viewport height allows comfortable, smooth video scrub */
    background-color: var(--canopy);
  }

  @media (max-width: 768px) {
    .hero-scroll-track {
      height: 320vh; /* Slightly shorter on mobile for rapid thumb scrolling */
    }
  }

  /* Sticky Viewport Stage: locks in place while track is scrolling */
  .hero-sticky-stage {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  /* Video Layer */
  .hero-video-box {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
    background-color: #0A241B;
  }

  .hero-video-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1.02); /* Avoid edge artifacts */
    transition: transform 0.1s ease-out;
  }

  .hero-video-scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 40% 40%, rgba(10, 36, 27, 0.45) 0%, rgba(8, 25, 18, 0.85) 100%),
                linear-gradient(to bottom, rgba(10, 36, 27, 0.6) 0%, rgba(7, 20, 15, 0.88) 100%);
    pointer-events: none;
  }

  /* Foreground Content Overlay */
  .hero-overlay-layer {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 3rem 0;
    pointer-events: auto;
  }

  .hero-container {
    width: 100%;
  }

  .hero-content {
    max-width: 860px;
    color: #FFFFFF;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.35rem 0.85rem;
    background: rgba(143, 191, 106, 0.18);
    border: 1px solid rgba(143, 191, 106, 0.4);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--sprout);
    margin-bottom: 1.25rem;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--sprout);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--sprout);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.8vw, 4rem);
    font-weight: 700;
    line-height: 1.12;
    color: #FFFFFF;
    margin-bottom: 1.15rem;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.7);
  }

  .hero-subline {
    font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
    line-height: 1.55;
    color: #E2ECE0;
    max-width: 720px;
    margin-bottom: 2rem;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .hero-btn {
    font-size: 1rem;
    padding: 0.875rem 1.75rem;
  }

  /* Trust Strip */
  .hero-trust-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.875rem;
    background: rgba(8, 28, 20, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius);
    padding: 1.15rem 1.35rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .trust-item {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .trust-icon {
    font-size: 1.15rem;
    line-height: 1;
  }

  .trust-text strong {
    font-size: 0.8125rem;
    color: #E8F1E6;
    font-weight: 600;
    line-height: 1.35;
    display: block;
  }

  /* Video Scrub Progress Indicator at bottom */
  .hero-scrub-indicator {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    width: min(90%, 420px);
    background: rgba(7, 24, 17, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .scrub-bar-track {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    overflow: hidden;
  }

  .scrub-bar-fill {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, var(--leaf) 0%, var(--sprout) 100%);
    border-radius: 999px;
    transition: width 0.05s linear;
  }

  .scrub-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.6875rem;
    color: #C7DACF;
    font-weight: 600;
  }

  .scrub-hint {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .scrub-pct {
    color: var(--sprout);
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .hero-btn {
      width: 100%;
    }
    .hero-trust-strip {
      grid-template-columns: 1fr;
    }
    .hero-scrub-indicator {
      bottom: 12px;
      padding: 0.4rem 0.75rem;
    }
  }
</style>

<script is:inline>
  // High-Performance Pinned Hero Video Scrubber
  document.addEventListener('DOMContentLoaded', () => {
    const video = document.getElementById('heroBgVideo');
    const track = document.getElementById('hero-track');
    const scrubFill = document.getElementById('scrub-bar-fill');
    const scrubPct = document.getElementById('scrub-pct');
    const contentPanel = document.getElementById('hero-content-panel');

    if (!video || !track) return;

    // Force immediate loading of video stream
    video.preload = 'auto';
    video.load();

    let targetTime = 0;
    let currentTime = 0;
    let isSeeking = false;

    function applyScrub(progress) {
      const p = Math.max(0, Math.min(1, progress));
      
      // Update scrub indicator
      if (scrubFill) scrubFill.style.width = `${(p * 100).toFixed(1)}%`;
      if (scrubPct) scrubPct.textContent = `${Math.round(p * 100)}%`;

      // Set target playback time
      if (video.duration && isFinite(video.duration)) {
        targetTime = p * video.duration;
      }

      // Smooth visual choreography:
      // Keep hero content 100% visible during 0% - 70% of video
      // Gently fade content slightly between 70% - 95% so user gets a clean cinematic view of vineyard
      // As user reaches 100%, content seamlessly transitions to the next section
      if (contentPanel) {
        if (p > 0.75) {
          const fadeOut = Math.max(0.15, 1 - ((p - 0.75) / 0.25) * 0.85);
          contentPanel.style.opacity = String(fadeOut);
          contentPanel.style.transform = `translateY(${-((p - 0.75) * 40)}px)`;
        } else {
          contentPanel.style.opacity = '1';
          contentPanel.style.transform = 'translateY(0px)';
        }
      }
    }

    function initScrubber() {
      // Pause automatic playback so scroll strictly drives video
      video.pause();

      if (window.ScrollTrigger && window.gsap) {
        gsap.registerPlugin(ScrollTrigger);

        ScrollTrigger.create({
          trigger: track,
          start: 'top top',
          end: 'bottom bottom',
          scrub: true,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            applyScrub(self.progress);
          }
        });

        // Fast, jitter-free video seek easing
        gsap.ticker.add(() => {
          if (!video.duration || !isFinite(video.duration)) return;
          const delta = targetTime - currentTime;
          if (Math.abs(delta) > 0.03 && !isSeeking) {
            currentTime += delta * 0.25;
            video.currentTime = currentTime;
          }
        });

        ScrollTrigger.refresh();
      } else {
        // Fallback standard scroll listener if GSAP hasn't loaded yet
        window.addEventListener('scroll', () => {
          const rect = track.getBoundingClientRect();
          const trackH = track.offsetHeight - window.innerHeight;
          if (trackH > 0) {
            const progress = -rect.top / trackH;
            applyScrub(progress);
            if (video.duration) {
              video.currentTime = Math.max(0, Math.min(1, progress)) * video.duration;
            }
          }
        }, { passive: true });
      }
    }

    if (video.readyState >= 1) {
      initScrubber();
    } else {
      video.addEventListener('loadedmetadata', initScrubber, { once: true });
      // Safety timeout
      setTimeout(initScrubber, 600);
    }

    // Touch/interaction gesture unlock for iOS/Safari video seeking
    const unlockAudio = () => {
      video.play().then(() => video.pause()).catch(() => {});
    };
    window.addEventListener('touchstart', unlockAudio, { once: true, passive: true });
    window.addEventListener('click', unlockAudio, { once: true, passive: true });
  });
</script>
