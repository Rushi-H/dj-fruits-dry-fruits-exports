    .modal-media-col {
      height: 220px;
      min-height: auto;
    }
    .modal-info-col {
      padding: 1.5rem 1.25rem;
    }
    .gallery-bottom-cta {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
