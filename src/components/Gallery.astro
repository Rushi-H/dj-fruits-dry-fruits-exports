</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Category Filtering with Smooth CSS Animations
    const filterBtns = document.querySelectorAll('.gallery-filter-btn');
    const cards = document.querySelectorAll('.gallery-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetFilter = btn.getAttribute('data-filter');

        // Update active button state
        filterBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        // Animate cards
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          const isMatch = targetFilter === 'all' || category === targetFilter;

          if (isMatch) {
            card.classList.remove('hidden');
            // Staggered reveal
            requestAnimationFrame(() => {
              card.classList.remove('fade-out');
            });
          } else {
            card.classList.add('fade-out');
            setTimeout(() => {
              if (card.classList.contains('fade-out')) {
                card.classList.add('hidden');
              }
            }, 200);
          }
        });
      });
    });

    // 2. Interactive Lightbox Modal
    const modal = document.getElementById('gallery-lightbox-modal');
    const backdrop = document.getElementById('modal-backdrop');
    const closeBtn = document.getElementById('modal-close-btn');

    const modalImg = document.getElementById('modal-img');
    const modalTitle = document.getElementById('modal-title');
    const modalDesc = document.getElementById('modal-desc');
    const modalBadge = document.getElementById('modal-badge');
    const modalRegion = document.getElementById('modal-region');
    const modalSpecVal = document.getElementById('modal-spec-val');
    const modalSeasonVal = document.getElementById('modal-season-val');
    const modalWaBtn = document.getElementById('modal-wa-btn');

    function openModal(data) {
      if (!modal || !data) return;

      modalImg.src = data.image;
      modalImg.alt = data.title;
      modalTitle.textContent = data.title;
      modalDesc.textContent = data.desc;
      modalBadge.textContent = data.badge;
      modalRegion.textContent = `📍 ${data.region}`;
      modalSpecVal.textContent = data.badge;
      modalSeasonVal.textContent = data.season || 'Active Season';

      const waMsg = `Hello DJ Fruits, I would like to enquire about supplying or selling [${data.title}] from my farm / collection centre.`;
      modalWaBtn.href = `https://wa.me/919130659595?text=${encodeURIComponent(waMsg)}`;

      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    cards.forEach(card => {
      card.addEventListener('click', () => {
        try {
          const itemData = JSON.parse(card.getAttribute('data-item') || '{}');
          openModal(itemData);
        } catch (e) {
          console.error('Failed to parse card data', e);
        }
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          card.click();
        }
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (backdrop) backdrop.addEventListener('click', closeModal);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.classList.contains('open')) {
        closeModal();
      }
    });
  });
</script>
