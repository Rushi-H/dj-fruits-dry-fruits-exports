---
interface Props {
  lang: 'en' | 'mr';
  dict: any;
}

const { lang, dict } = Astro.props;

const defaultText = lang === 'mr'
  ? 'नमस्कार, मला डीजे फ्रूट्सकडे शेतमाल विक्रीसाठी संपर्क करायचा आहे.'
  : 'Hello DJ Fruits Export desk, I would like to enquire about selling fresh produce.';
const waUrl = `https://wa.me/919130659595?text=${encodeURIComponent(defaultText)}`;
---

<aside class="floating-whatsapp-container" aria-label="Direct WhatsApp contact">
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-float-btn"
    id="global-whatsapp-float"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 6.46 17.5 2 12.04 2M12.05 3.67C16.58 3.67 20.28 7.37 20.28 11.92C20.28 16.46 16.58 20.17 12.04 20.17C10.59 20.17 9.17 19.79 7.92 19.05L7.62 18.87L4.5 19.69L5.33 16.65L5.13 16.33C4.33 15.05 3.8 13.51 3.8 11.91C3.81 7.37 7.51 3.67 12.05 3.67Z"/>
    </svg>
    <span class="float-btn-label">
      {lang === 'mr' ? 'व्हॉट्सॲपवर बोला' : 'Chat on WhatsApp'}
    </span>
  </a>
</aside>

<style>
  .floating-whatsapp-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 990;
  }

  .whatsapp-float-btn {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    background-color: #128C7E;
    color: #FFFFFF;
    text-decoration: none;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 700;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35), 2px 2px 0px #075E54;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .whatsapp-float-btn:hover {
    background-color: #0b7367;
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4), 3px 3px 0px #075E54;
  }

  @media (max-width: 640px) {
    .floating-whatsapp-container {
      bottom: 16px;
      right: 16px;
    }
    .whatsapp-float-btn {
      padding: 0.65rem 1rem;
      font-size: 0.8125rem;
    }
  }
</style>
