---
import Layout from '../../../layouts/Layout.astro';
import mr from '../../../i18n/mr.json';

export async function getStaticPaths() {
  const posts = import.meta.glob('../../../../content/blog/*.mr.md', { eager: true });
  return Object.values(posts).map((mod: any) => ({
    params: { slug: mod.frontmatter.slug },
    props: { post: mod }
  }));
}

const { post } = Astro.props;
const { Content, frontmatter } = post;
const lang = 'mr';
const dict = mr;

const postUrl = `https://djfruits.com/mr/blog/${frontmatter.slug}`;
const shareWa = `https://wa.me/?text=${encodeURIComponent(`${frontmatter.title} - ${postUrl}`)}`;

// Article JSON-LD
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": frontmatter.title,
  "description": frontmatter.excerpt,
  "image": `https://djfruits.com${frontmatter.coverImage}`,
  "datePublished": frontmatter.date,
  "author": {
    "@type": "Organization",
    "name": "डीजे फ्रूट्स अँड ड्रायफ्रूट्स एक्सपोर्ट्स"
  }
};
---

<Layout
  lang={lang}
  title={`${frontmatter.title} | डीजे फ्रूट्स अँड ड्रायफ्रूट्स एक्सपोर्ट्स`}
  description={frontmatter.excerpt}
  canonicalPath={`/mr/blog/${frontmatter.slug}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <article class="section-opaque single-post-page">
    <div class="container article-container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/mr/blog">← मागे सल्लागार पानाकडे</a>
      </nav>

      <header class="post-header">
        <div class="post-meta">
          <span class="post-cat">{frontmatter.category}</span>
          <span class="post-date tabular-nums">{frontmatter.date}</span>
          <span class="post-time">{frontmatter.readingTime} {dict.blog.reading_time}</span>
          {frontmatter.draft && <span class="draft-tag">{dict.blog.draft_notice}</span>}
        </div>

        <h1 class="post-main-title">{frontmatter.title}</h1>
        <p class="post-deck">{frontmatter.excerpt}</p>
      </header>

      <figure class="post-figure">
        <img src={frontmatter.coverImage} alt={frontmatter.title} class="post-hero-img" />
        {frontmatter.imageCaption && (
          <figcaption class="post-caption">{frontmatter.imageCaption}</figcaption>
        )}
      </figure>

      <div class="markdown-body">
        <Content />
      </div>

      <div class="post-footer-actions">
        <a href={shareWa} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 6.46 17.5 2 12.04 2M12.05 3.67C16.58 3.67 20.28 7.37 20.28 11.92C20.28 16.46 16.58 20.17 12.04 20.17C10.59 20.17 9.17 19.79 7.92 19.05L7.62 18.87L4.5 19.69L5.33 16.65L5.13 16.33C4.33 15.05 3.8 13.51 3.8 11.91C3.81 7.37 7.51 3.67 12.05 3.67Z"/>
          </svg>
          <span>{dict.blog.share_whatsapp}</span>
        </a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .single-post-page {
    padding: 3.5rem 0 6rem;
  }

  .article-container {
    max-width: 820px;
  }

  .breadcrumb-nav {
    margin-bottom: 2rem;
  }

  .breadcrumb-nav a {
    color: var(--leaf);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-dim);
    margin-bottom: 1rem;
  }

  .post-cat {
    background: rgba(46, 125, 79, 0.12);
    color: var(--leaf);
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
  }

  .draft-tag {
    font-size: 0.75rem;
    color: var(--amber);
    background: #FDF9F0;
    padding: 0.2rem 0.5rem;
    border: 1px solid #EAD8B5;
    border-radius: 2px;
    font-weight: 600;
  }

  .post-main-title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .post-deck {
    font-size: 1.15rem;
    color: var(--ink-dim);
    line-height: 1.7;
  }

  .post-figure {
    margin-bottom: 2.5rem;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border-rule);
    background: #EAEFE7;
  }

  .post-hero-img {
    width: 100%;
    height: auto;
    display: block;
    max-height: 440px;
    object-fit: cover;
  }

  .post-caption {
    padding: 0.6rem 1rem;
    font-size: 0.8125rem;
    color: var(--ink-dim);
    background: #F7FAF5;
    border-top: 1px solid var(--border-rule);
    font-style: italic;
  }

  .markdown-body {
    font-size: 1.125rem;
    line-height: 1.85;
    color: var(--ink);
    margin-bottom: 3.5rem;
  }

  .markdown-body :global(h2) {
    font-size: 1.8rem;
    margin: 2.25rem 0 1rem;
    color: var(--canopy);
  }

  .markdown-body :global(h3) {
    font-size: 1.4rem;
    margin: 1.75rem 0 0.75rem;
    color: var(--canopy);
  }

  .markdown-body :global(p) {
    margin-bottom: 1.35rem;
  }

  .markdown-body :global(ul), .markdown-body :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .markdown-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-footer-actions {
    padding-top: 2rem;
    border-top: 1px solid var(--border-rule);
    display: flex;
    justify-content: flex-end;
  }
</style>
