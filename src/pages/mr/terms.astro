---
import Layout from '../../layouts/Layout.astro';
import mr from '../../i18n/mr.json';

const lang = 'mr';
const dict = mr;
---

<Layout
  lang={lang}
  title="नियम व अटी | डीजे फ्रूट्स अँड ड्रायफ्रूट्स एक्सपोर्ट्स"
  description="शेतमाल खरेदी कोटेशन, प्रत्यक्ष तपासणी आणि प्रमाणित वजन पद्धतीबाबतचे नियम व अटी."
  canonicalPath="/mr/terms"
>
  <div class="section-opaque legal-page">
    <div class="container legal-container">
      <h1 class="legal-title">नियम व अटी (Terms of Use)</h1>
      <p class="legal-date">अद्ययावत: ११ ऑक्टोबर २०२६</p>

      <div class="legal-content">
        <h2>१. खरेदी दर व कोटेशन</h2>
        <p>
          प्रत्यक्ष खरेदी दर हा तुमच्या शेतात किंवा आमच्या मनेराजुरी पॅकहाऊसवर शेतमालाची गुणवत्ता, गोडवा (ब्रिक्स) व आकारमान तपासून खाजगीरित्या निश्चित केला जातो. वेबसाईटवर कोणतेही निश्चित सार्वजनिक खरेदी दर जाहीर केले जात नाहीत.
        </p>

        <h2>२. शेतमाल नोंदणी पावती</h2>
        <p>
          डिजिटल नोंदणी पावती ही शेतमाल वाहतूक आणि प्रत्यक्ष तपासणीचे नियोजन करण्यासाठी आहे. प्रत्यक्ष वजन आमच्या मनेराजुरी पॅकहाऊसवर अधिकृत डिजिटल वजनकाट्यावर झाल्यावर अंतिम खरेदी पावती दिली जाते.
        </p>

        <h2>३. पेमेंट पद्धत</h2>
        <p>
          मालाची खरेदी पावती झाल्यावर थेट शेतकऱ्याच्या बँक खात्यात आरटीजीएस किंवा एनइएफटीद्वारे रक्कम जमा केली जाते.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .legal-page {
    padding: 4.5rem 0 6rem;
  }
  .legal-container {
    max-width: 780px;
  }
  .legal-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 0.5rem;
    color: var(--canopy);
  }
  .legal-date {
    font-size: 0.875rem;
    color: var(--ink-dim);
    margin-bottom: 2.5rem;
  }
  .legal-content h2 {
    font-size: 1.35rem;
    color: var(--canopy);
    margin: 2rem 0 0.75rem;
  }
  .legal-content p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--ink);
    margin-bottom: 1.25rem;
  }
</style>
