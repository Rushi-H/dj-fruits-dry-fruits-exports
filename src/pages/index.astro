---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import FruitsCarouselSection from '../components/FruitsCarouselSection.astro';
import Farmers from '../components/Farmers.astro';
import Products from '../components/Products.astro';
import Origin from '../components/Origin.astro';
import Contact from '../components/Contact.astro';
import en from '../i18n/en.json';

const lang = 'en';
const dict = en;
---

<Layout
  lang={lang}
  title="DJ Fruits and Dry Fruits Exports | Direct Farm Procurement & Export Supply"
  description="We buy export-grade grapes, raisins, pomegranate, almonds, and dates directly from farmers across Sangli, Solapur, Nashik, and Pune. Calibrated digital weighing & prompt settlement."
  canonicalPath="/"
>
  <!-- Hero Section with Background Video -->
  <Hero lang={lang} dict={dict} />

  <!-- Animated Product & Packhouse Gallery -->
  <Gallery lang={lang} dict={dict} />

  <!-- 3D Fruit Water Ripple Carousel Section -->
  <FruitsCarouselSection lang={lang} dict={dict} />

  <!-- Farmers Procurement & Farm Lot Registration Slip -->
  <Farmers lang={lang} dict={dict} />

  <!-- Products We Procure & Sourcing Calendar -->
  <Products lang={lang} dict={dict} />

  <!-- Origin Footprint & Interactive Maharashtra Map -->
  <Origin lang={lang} dict={dict} />

  <!-- Direct Contact & Collection Packhouse -->
  <Contact lang={lang} dict={dict} />
</Layout>
